OPENAI_API_KEY=

# Required — PostgreSQL connection string (no default; the app will refuse to start without it)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/multi_agent

# Required — shared secret between Next.js proxy and FastAPI; must be set in both environments
API_KEY=

# CORS — comma-separated list of allowed frontend origins (default: http://localhost:3000)
# ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# Frontend (server-side only, not exposed to the browser)
# AGENT_API_BASE_URL=http://127.0.0.1:8000

# Optional runtime overrides
# AUTO_MIGRATE_ON_STARTUP=true
# DB_INIT_MAX_ATTEMPTS=60
# DB_INIT_RETRY_SECONDS=2
